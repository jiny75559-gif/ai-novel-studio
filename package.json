{
  "name": "novel-studio",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/prepare-pdf-assets.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "test:rust": "cargo +stable test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --bundles nsis",
    "mock": "node scripts/mock-ai.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@xyflow/react": "^12.8.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.35.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
